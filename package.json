{
  "name": "pb-coop-tool",
  "version": "1.3.0-beta.1",
  "private": true,
  "description": "Experimental PokéBonk co-op diagnostics and bounded connection recovery",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "package:installer": "node tools/build-installer.mjs",
